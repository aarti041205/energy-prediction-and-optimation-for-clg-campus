[Unit]
Description=Campus Energy FastAPI Service
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Energy-Prediction-Optimization-System
ExecStart=/home/ubuntu/Energy-Prediction-Optimization-System/venv/bin/uvicorn src.api.app:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/Energy-Prediction-Optimization-System/.env

[Install]
WantedBy=multi-user.target

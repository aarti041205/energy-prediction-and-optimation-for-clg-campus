# Database Credentials (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_energy
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/campus_energy

# Google Gemini API Key
GOOGLE_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.6-flash

# SMTP Email Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@campusenergy.ai
SMTP_PASSWORD=your_smtp_app_password
SENDER_EMAIL=alerts@campusenergy.ai
RECIPIENT_EMAILS=facility@campus.edu,admin@campus.edu

# AWS Settings (Optional)
AWS_REGION=us-east-1
S3_BUCKET_NAME=campus-energy-reports
